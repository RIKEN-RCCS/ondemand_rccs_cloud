# Set xfce environment and _VIRTUALGL
<%= xfce_startup_script(vgl_available?(context.global_queue, context.global_gpus)) %>
export SHELL="${LOGIN_SHELL:-/bin/bash}"

# Start PyMOL
<% if !context.global_input_file.to_s.empty? %>
${_VIRTUALGL} /usr/bin/pymol "<%= context.global_input_file %>" &
<% else %>
${_VIRTUALGL} /usr/bin/pymol &
<% end %>

# Start up xfce desktop (block until user logs out of desktop)
xfce4-session
