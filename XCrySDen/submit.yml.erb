<%
  require_relative "/var/www/ood/apps/sys/ondemand_rccs_cloud/misc/config.rb"
  XDG_DATA_HOME, CONTAINER_IMAGE = site_paths
  APP_NAME = "XCrySDen"
%>
---
batch_connect:
  template: vnc
  websockify_cmd: '/usr/bin/websockify'
  script_wrapper: |
    cat << "CTRSCRIPT" > container.sh
    export LANG=C
    export PATH="$PATH:/opt/TurboVNC/bin"
    %s
    CTRSCRIPT

    # Set SINGULARITY_BINDPATH and _OPTION
    <%= gpu_bind_script %>
    export SINGULARITY_BINDPATH=${SINGULARITY_BINDPATH},/cloud_opt,/lvs0,/hs
    [ -d /usr/share/modules/modulefiles ] && export SINGULARITY_BINDPATH=${SINGULARITY_BINDPATH},/usr/share/modules/modulefiles
    export SINGULARITYENV_LOGIN_SHELL="$(getent passwd $USER | cut -d: -f7)"
    export SINGULARITYENV_SHELL="$(getent passwd $USER | cut -d: -f7)"

    if [ `arch` = "x86_64" ]; then
      export SINGULARITYENV_XDG_DATA_HOME=<%= XDG_DATA_HOME["x86_64"] %>/<%= APP_NAME %>
      singularity run ${_OPTION} <%= CONTAINER_IMAGE["x86_64"] %> bash ./container.sh
    else
      export SINGULARITYENV_XDG_DATA_HOME=<%= XDG_DATA_HOME["aarch64"] %>/<%= APP_NAME %>
      case "<%= global_queue %>" in
        fx700)
          singularity run ${_OPTION} /cloud_opt/ondemand/rocky97_fx700_aarch64.sif bash ./container.sh
          ;;
        *)
          singularity run ${_OPTION} <%= CONTAINER_IMAGE["aarch64"] %> bash ./container.sh
          ;;
      esac
    fi

script:
  <%= job_script_yaml("ood_#{APP_NAME}", global_queue_x86, global_hours, global_gpus, global_email) %>
