<%- GroupQuota.group_names.each do |group_name| -%>
<%
  group_dir = GroupQuota.group_dir(group_name)
  group_link = link_to("/pun/sys/dashboard/files/fs#{group_dir}", target: '_blank', rel: 'noopener', class: 'rccs-link-header') do
    raw("#{ERB::Util.html_escape(group_dir)}<i class=\"fas fa-external-link-alt rccs-ext-icon\" aria-hidden=\"true\"></i>")
  end

  # Rescue per group so one failing lfs call does not hide the other groups' cards
  begin
    quota = GroupQuota.fetch(group_name)
  rescue GroupQuota::Error
    quota = nil
  end
%>
<%= render partial: 'widgets/quota_card', locals: { title: group_link, icon: 'fa-users', quota: quota } %>
<%- end -%>
